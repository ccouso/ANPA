# Variables para Docker Compose
APP_SECRET=change-this-value-in-production
COOKIE_SECURE=true
APP_PORT=8000
APP_VERSION=latest
ANPA_IMAGE=ghcr.io/ccouso/anpa

# En el contenedor, la base de datos vive en /data/comedor.db
# DATABASE_URL=sqlite:////data/comedor.db

# SMTP para envío de contraseñas provisionales de nuevos usuarios
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=notificaciones@example.com
SMTP_PASSWORD=change-me
SMTP_FROM_EMAIL=notificaciones@example.com
SMTP_FROM_NAME=ANPA Comedor
SMTP_USE_TLS=true
SMTP_USE_SSL=false
APP_PUBLIC_URL=http://localhost:8000
